# data.go.kr 실거래가 API 키 (디코딩된 키)
# 발급: https://www.data.go.kr 가입 → '국토교통부_아파트매매 실거래 상세 자료' API 신청
DATA_GO_KR_API_KEY=your_api_key_here

# 오피스텔 매매 API 전용 키 (별도 활용신청 필요, 선택)
# 발급: '국토교통부_오피스텔 매매 실거래가 자료' API 활용신청
DATA_GO_KR_API_KEY_OFFICE=your_officetel_api_key_here

# Kakao Developers REST API 키 (주소→좌표 변환에 사용)
# 발급: https://developers.kakao.com → 애플리케이션 추가 → REST API 키 복사
KAKAO_REST_API_KEY=your_kakao_rest_key_here

# Kakao JavaScript 키 (Flutter 앱 카카오맵에 사용)
# 같은 Kakao 앱에서 JavaScript 키 복사
KAKAO_JS_KEY=your_kakao_js_key_here
